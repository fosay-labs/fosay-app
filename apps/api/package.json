{
  "name": "@fosay/api",
  "version": "0.1.0",
  "private": true,
  "description": "FOSAY API: event indexer, web push, fee-sponsoring relayer, TTL keeper, read API.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
