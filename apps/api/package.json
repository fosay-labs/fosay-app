    "@hono/node-server": "2.1.6",
    "@stellar/stellar-sdk": "16.4.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "postgres": "4.1.0",
    "tsx": "4.23.15",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11"
  }
}
